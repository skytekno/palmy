  "components": {
    "schemas": {
      "Account": {
        "type": "object",
        "required": [
          "account_id"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Challenge": {
        "type": "object",
        "required": [
          "challenge_id",
          "nonce",
          "expires_at"
        ],
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "nonce": {
            "type": "string"
          }
        }
      },
      "ChallengeRequest": {
        "type": "object",
        "required": [
          "account_id"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "CreateTransaction": {
        "type": "object",
        "required": [
          "wallet_id",
          "kind",
          "amount",
          "category",
          "description",
          "effective_on"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "description": "Positive exact decimal string, at most 16 integer and 2 fractional digits.",
            "example": "1234.56",
            "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
          },
          "category": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 280
          },
          "effective_on": {
            "type": "string",
            "format": "date"
          },
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "wallet_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "CreateWallet": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "Data_Account": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "account_id"
            ],
            "properties": {
              "account_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "Data_Challenge": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "challenge_id",
              "nonce",
              "expires_at"
            ],
            "properties": {
              "challenge_id": {
                "type": "string",
                "format": "uuid"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              },
              "nonce": {
                "type": "string"
              }
            }
          }
        }
      },
      "Data_Profile": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "account_id",
              "profile",
              "version"
            ],
            "properties": {
              "account_id": {
                "type": "string",
                "format": "uuid"
              },
              "profile": {
                "$ref": "#/components/schemas/ProfileEnvelope"
              },
              "version": {
                "type": "integer",
                "format": "int64"
              }
            }
          }
        }
      },
      "Data_Session": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "access_token",
              "expires_at"
            ],
            "properties": {
              "access_token": {
                "type": "string"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "Data_Summary": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "balance",
              "income",
              "expense",
              "currency"
            ],
            "properties": {
              "balance": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "expense": {
                "type": "string"
              },
              "income": {
                "type": "string"
              }
            }
          }
        }
      },
      "Data_Transaction": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "id",
              "wallet_id",
              "kind",
              "amount",
              "category",
              "description",
              "effective_on",
              "created_at"
            ],
            "properties": {
              "amount": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "description": {
                "type": "string"
              },
              "effective_on": {
                "type": "string",
                "format": "date"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "kind": {
                "$ref": "#/components/schemas/Kind"
              },
              "wallet_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "Data_Vec_Wallet": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "balance",
                "currency"
              ],
              "properties": {
                "balance": {
                  "type": "string"
                },
                "currency": {
                  "type": "string"
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Data_Wallet": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "id",
              "name",
              "balance",
              "currency"
            ],
            "properties": {
              "balance": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              }
            }
          }
        }
      },
      "Kind": {
        "type": "string",
        "enum": [
          "income",
          "expense"
        ]
      },
      "Problem": {
        "type": "object",
        "required": [
          "status",
          "title",
          "code",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
