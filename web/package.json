{
  "name": "@palmy/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "build:delivery": "node --experimental-strip-types delivery/build.mts",
    "serve:delivery": "node --experimental-strip-types delivery/server.mts",
    "test:delivery": "node --experimental-strip-types ../scripts/delivery-check.mjs",
    "start": "node scripts/preview.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "next": "16.3.6",
    "parse5": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
